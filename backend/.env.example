DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Postgres (Django connects here — NOT via @supabase/supabase-js)
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use "Session pooler" (port 6543) or "Direct" (port 5432). Replace [YOUR-PASSWORD].
#
# Local: direct connection is fine
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Railway/cloud: use Session pooler URI from Supabase (avoids IPv6 errors)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

CORS_ALLOWED_ORIGINS=http://localhost:5173
