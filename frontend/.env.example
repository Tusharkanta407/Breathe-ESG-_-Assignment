# Dev only: where Vite proxies /api → (not used by browser fetch; client always calls /api).
# Use Railway when Django is not running locally:
VITE_API_BASE=https://YOUR-RAILWAY-APP.up.railway.app/api
# Or omit to proxy to http://127.0.0.1:8000 when running python manage.py runserver

# Do NOT set VITE_API_BASE on Vercel (causes CORS). Production uses vercel.json /api proxy.
